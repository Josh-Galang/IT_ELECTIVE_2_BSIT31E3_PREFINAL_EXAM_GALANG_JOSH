<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IT Elective 2 — Prefinal Exam Answer Key</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="exam-header">
        <div class="exam-header__seal">CCS</div>
        <div class="exam-header__text">
            <p class="exam-header__college">College of Computer Studies</p>
            <h1 class="exam-header__title">IT Elective 2 &mdash; Web System and Technologies</h1>
            <p class="exam-header__sub">Prefinal Examination &middot; 1st Semester, A.Y. 2026&ndash;2027</p>
        </div>
    </header>

    <section class="student-strip">
        <div><span class="label">Name</span><span class="value">Galang, Josh</span></div>
        <div><span class="label">Section</span><span class="value">BSIT31E3</span></div>
        <div><span class="label">Subject</span><span class="value">IT Elective 2</span></div>
    </section>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="exam-footer">
        <p>Answer key rendered by ExamMVC &middot; ASP.NET Core MVC &middot; no database used</p>
    </footer>
</body>
</html>
