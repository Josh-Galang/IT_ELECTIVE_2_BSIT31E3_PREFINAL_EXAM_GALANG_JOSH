@model List<Question>

<div class="progress-strip">
    <span>@Model.Count / 20 items answered</span>
    <div class="progress-track">
        <div class="progress-fill" style="width:@(Model.Count * 5)%"></div>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="empty-state">No questions loaded yet.</p>
}

<div class="question-grid">
    @foreach (var q in Model)
    {
        <article class="q-card">
            <div class="q-card__number">@q.Number</div>
            <div class="q-card__body">
                <p class="q-card__text">@q.Text</p>
                <ul class="q-card__options">
                    @foreach (var opt in q.Options)
                    {
                        var isCorrect = opt.Letter == q.CorrectLetter;
                        <li class="@(isCorrect ? "option option--correct" : "option")">
                            <span class="option__letter">@opt.Letter</span>
                            <span class="option__text">@opt.Text</span>
                            @if (isCorrect)
                            {
                                <span class="option__check">&#10003;</span>
                            }
                        </li>
                    }
                </ul>
                <div class="q-card__answer">
                    <span class="answer-badge">Answer: @q.CorrectLetter</span>
                    <p class="explanation">@q.Explanation</p>
                </div>
            </div>
        </article>
    }
</div>
